<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>rigscope</vendor>
  <vendor_url>https://github.com/nazdravan/rigscope</vendor_url>
  <action id="org.rigscope.dump-dmi">
    <description>Read the SMBIOS table and disk SMART data</description>
    <message>Authentication is required to read hardware details (SMBIOS, SMART) that only root can see</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/rigscope/rigscope-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--dump-dmi</annotate>
  </action>
</policyconfig>
