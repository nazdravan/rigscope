// Windows resources of rigscope.exe: the administrator manifest, the icon, the version.
// RIGSCOPE_VERSION_COMMA and RIGSCOPE_VERSION_STR come from build.rs.
#include <winres.h>
1 RT_MANIFEST "rigscope.manifest"
1 ICON "rigscope.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION RIGSCOPE_VERSION_COMMA
PRODUCTVERSION RIGSCOPE_VERSION_COMMA
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "rigscope - hardware configuration viewer"
      VALUE "ProductName", "rigscope"
      VALUE "FileVersion", RIGSCOPE_VERSION_STR
      VALUE "ProductVersion", RIGSCOPE_VERSION_STR
      VALUE "LegalCopyright", "MIT OR Apache-2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
